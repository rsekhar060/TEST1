<!DOCTYPE html>
<html>

<head>

<meta charset="UTF-8">

<title>PO_PRICE vs UC_PRICE Dashboard</title>

<style>

body{
  font-family:Arial;
  background:#f5f5f5;
  padding:20px;
  margin:0;
}

h1{
  text-align:center;
  margin-bottom:25px;
}

.summary{
  display:flex;
  gap:20px;
  margin-bottom:25px;
}

.card{
  flex:1;
  padding:20px;
  border-radius:10px;
  color:white;
  text-align:center;
  font-size:22px;
  font-weight:bold;
}

.green{
  background:#28a745;
}

.red{
  background:#dc3545;
}

.blue{
  background:#007bff;
}

table{
  width:100%;
  border-collapse:collapse;
  background:white;
}

th{
  background:#111;
  color:white;
  padding:12px;
}

td{
  padding:10px;
  border-bottom:1px solid #ddd;
  text-align:center;
}

.match{
  background:#d4edda;
}

.flag{
  background:#f8d7da;
  font-weight:bold;
}

.loader{
  text-align:center;
  padding:20px;
  font-size:20px;
}

</style>

</head>

<body>

<h1>PO_PRICE vs UC_PRICE Dashboard</h1>

<div class="summary">

  <div class="card green">
    MATCH
    <div id="matchCount">0</div>
  </div>

  <div class="card red">
    FLAG
    <div id="flagCount">0</div>
  </div>

  <div class="card blue">
    TOTAL
    <div id="totalCount">0</div>
  </div>

</div>

<div class="loader" id="loader">
Loading Dashboard...
</div>

<table>

<thead>

<tr>
<th>PoNumber</th>
<th>FacilityName</th>
<th>SkuCode</th>
<th>OrderedQty</th>
<th>PO_PRICE</th>
<th>UC_PRICE</th>
<th>STATUS</th>
</tr>

</thead>

<tbody id="tbody"></tbody>

</table>

<script>

const API_URL =
"https://script.google.com/macros/s/AKfycbwDlS2WBFsAdN2Nz92iYkcqU5IpVjp45At7N7zDYSpekPQTBS9o8Ed47QcUZzok3HLTgw/exec";

async function loadDashboard(){

  try{

    const response =
    await fetch(API_URL);

    const data =
    await response.json();

    const tbody =
    document.getElementById("tbody");

    tbody.innerHTML = "";

    let match = 0;
    let flag = 0;

    data.forEach(row => {

      if(row.STATUS === "MATCH"){
        match++;
      }else{
        flag++;
      }

      const tr =
      document.createElement("tr");

      tr.className =
      row.STATUS === "MATCH"
      ? "match"
      : "flag";

      tr.innerHTML = `
        <td>${row.PoNumber || ""}</td>
        <td>${row.FacilityName || ""}</td>
        <td>${row.SkuCode || ""}</td>
        <td>${row.OrderedQty || ""}</td>
        <td>${row.PO_PRICE || ""}</td>
        <td>${row.UC_PRICE || ""}</td>
        <td>${row.STATUS || ""}</td>
      `;

      tbody.appendChild(tr);

    });

    document.getElementById("matchCount")
    .innerText = match;

    document.getElementById("flagCount")
    .innerText = flag;

    document.getElementById("totalCount")
    .innerText = data.length;

    document.getElementById("loader")
    .style.display = "none";

  }

  catch(error){

    console.log(error);

    document.getElementById("loader")
    .innerHTML =
    "Apps Script Permission Error";

  }

}

loadDashboard();

</script>

</body>
</html>
