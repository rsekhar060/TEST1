<!DOCTYPE html>
<html>

<head>

  <title>PO vs UC Dashboard</title>

  <style>

    body{
      font-family:Arial;
      background:#f4f6f9;
      padding:20px;
      margin:0;
    }

    h1{
      text-align:center;
      margin-bottom:25px;
    }

    .summary{
      display:flex;
      gap:20px;
      margin-bottom:25px;
    }

    .card{
      flex:1;
      padding:20px;
      border-radius:10px;
      color:white;
      text-align:center;
      font-size:20px;
      font-weight:bold;
    }

    .green{
      background:#28a745;
    }

    .red{
      background:#dc3545;
    }

    .blue{
      background:#007bff;
    }

    table{
      width:100%;
      border-collapse:collapse;
      background:white;
    }

    th{
      background:#222;
      color:white;
      padding:12px;
    }

    td{
      padding:10px;
      border-bottom:1px solid #ddd;
      text-align:center;
    }

    .match{
      background:#d4edda;
    }

    .flag{
      background:#f8d7da;
      font-weight:bold;
    }

  </style>

</head>

<body>

  <h1>PO_PRICE vs UC_PRICE Dashboard</h1>

  <div class="summary">

    <div class="card green">
      MATCHED
      <div id="matchedCount">0</div>
    </div>

    <div class="card red">
      FLAGGED
      <div id="flagCount">0</div>
    </div>

    <div class="card blue">
      TOTAL
      <div id="totalCount">0</div>
    </div>

  </div>

  <table>

    <thead>

      <tr>
        <th>PoNumber</th>
        <th>FacilityName</th>
        <th>SkuCode</th>
        <th>OrderedQty</th>
        <th>PO_PRICE</th>
        <th>UC_PRICE</th>
        <th>STATUS</th>
      </tr>

    </thead>

    <tbody id="tableBody"></tbody>

  </table>

  <script>

    const API_URL =
    "https://script.google.com/macros/s/AKfycbwDlS2WBFsAdN2Nz92iYkcqU5IpVjp45At7N7zDYSpekPQTBS9o8Ed47QcUZzok3HLTgw/exec";

    fetch(API_URL)

    .then(response => response.json())

    .then(data => {

      let matched = 0;
      let flagged = 0;

      const tbody =
      document.getElementById("tableBody");

      data.forEach(row => {

        if(row.STATUS === "MATCH"){
          matched++;
        }else{
          flagged++;
        }

        const tr =
        document.createElement("tr");

        tr.className =
        row.STATUS === "MATCH"
        ? "match"
        : "flag";

        tr.innerHTML = `

          <td>${row.PoNumber}</td>
          <td>${row.FacilityName}</td>
          <td>${row.SkuCode}</td>
          <td>${row.OrderedQty}</td>
          <td>${row.PO_PRICE}</td>
          <td>${row.UC_PRICE}</td>
          <td>${row.STATUS}</td>

        `;

        tbody.appendChild(tr);

      });

      document.getElementById("matchedCount")
      .innerText = matched;

      document.getElementById("flagCount")
      .innerText = flagged;

      document.getElementById("totalCount")
      .innerText = data.length;

    });

  </script>

</body>
</html>
